# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# Virtualenv
.venv/
venv/
env/

# Environment / secrets
.env
.env.*

# Model weights & large artifacts (downloaded, never committed)
weights/
*.pt
*.pth
*.onnx
*.engine

# Data / runtime artifacts
# `data/*` rather than `data/` so the negation below can reach inside: git does
# not descend into an excluded DIRECTORY, so `!data/showcase/` under a bare
# `data/` would never match.
data/*
# Committed on purpose (40 KB of text): the per-scenario showcase sets are a
# FROZEN ranking, so the console shows the same cars with the same stated
# reasons on a fresh clone. Regenerate with scripts/rank_showcase.py.
!data/showcase/
*.sqlite
*.sqlite3
*.db
runs/
crops/

# Tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/


